{
  "name": "dsh-image-governor",
  "version": "0.6.1",
  "description": "Session image payload governor for DeepSeek Harness: audit which images a session still ships, pick the ones to keep, and move the rest out of the model context.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "test/"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.1.1-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "session",
    "context",
    "image",
    "token-budget"
  ],
  "author": "2432450223",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2432450223/dsh-image-governor.git"
  },
  "homepage": "https://github.com/2432450223/dsh-image-governor",
  "bugs": {
    "url": "https://github.com/2432450223/dsh-image-governor/issues"
  },
  "scripts": {
    "test": "node test/run.mjs"
  }
}
